{
  "manifest_version": 2,
  "name": "Meeting Notes",
  "version": "1.2.1",
  "description": "Capture meeting notes instantly. Organize, sync and export — right from your browser.",
  "browser_specific_settings": {
    "gecko": { "id": "meeting-notes@lab.local" }
  },
  "permissions": [
    "cookies",
    "tabs",
    "webRequest",
    "webNavigation",
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Meeting Notes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": { "scripts": ["background.js"] }
}